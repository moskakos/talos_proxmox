# Contains the talos machine configuration overrides for all nodes
{% set talos_proxmox_modern_config = talos_proxmox_talos_version is version('v1.14.0', '>=') %}
version: v1alpha1
machine:
  network:
    interfaces:
      - deviceSelector:
          physical: true
        dhcp: false
        {% if talos_proxmox_enable_vlans -%}
        vlans:
          - vlanId: {{ talos_proxmox_mgmt_vlan_id }}
            dhcp: false
            routes:
              - network: 0.0.0.0/0
                gateway: {{ talos_proxmox_mgmt_gateway }}
          {% for talos_proxmox_vlan in talos_proxmox_vlan_config -%}
          - vlanId: {{ talos_proxmox_vlan.vlan_id }}
            dhcp: false
            addresses: []
          {% endfor -%}
        {% else -%}
        routes:
          - network: 0.0.0.0/0
            gateway: {{ talos_proxmox_mgmt_gateway }}
        {% endif %}

{% if not talos_proxmox_modern_config %}
    nameservers:
        {% for talos_proxmox_ns in talos_proxmox_nameservers -%}
        - {{ talos_proxmox_ns }}
        {% endfor %}
{% endif %}

    extraHostEntries:
      - ip: {{ talos_proxmox_cluster_shared_ip }}
        aliases:
            - {{ talos_proxmox_cluster_name | split('.') | first }}
            - {{ talos_proxmox_cluster_name }}

{% if not talos_proxmox_modern_config %}
  install:
    disk: {{ talos_proxmox_talos_installation_disk_path }}
    image: {{ talos_proxmox_talos_installer_image_url }}
    wipe: {{ talos_proxmox_talos_installation_disk_wipe | default(false, true) }}
{% endif %}

  time:
    disabled: false
    servers:
      {% for talos_proxmox_ts in talos_proxmox_timeservers -%}
      - {{ talos_proxmox_ts }}
      {% endfor %}

  sysctls:
    {% if talos_proxmox_enable_longhorn_support -%}
    vm.nr_hugepages: "1024"
    {% endif -%}
    net/ipv6/conf/all/disable_ipv6: "{% if talos_proxmox_disable_ipv6 %}1{% else %}0{% endif %}"
  
  {% if talos_proxmox_enable_longhorn_support -%}
  kernel:
    modules:
      - name: nvme_tcp
      - name: vfio_pci
  {% endif %}

{% if not talos_proxmox_modern_config or talos_proxmox_install_cilium or talos_proxmox_enable_gateway_api %}
cluster:
{% if not talos_proxmox_modern_config %}
  allowSchedulingOnControlPlanes: true
  apiServer:
    certSANs:
      - {{ talos_proxmox_cluster_name | split('.') | first }}
      - {{ talos_proxmox_cluster_shared_ip }}

  {% if talos_proxmox_install_cilium -%}
  network:
    cni:
      name: none
  proxy:
    disabled: true
  {% endif %}
{% endif %}

{% if talos_proxmox_install_cilium %}
  inlineManifests:
    - name: cilium
      contents: |
{{ talos_proxmox_cilium_manifest.stdout_lines | join('\n') | indent(8, true) }}
{% endif %}

{% if talos_proxmox_enable_gateway_api %}
  extraManifests:
{% for talos_proxmox_gw_crd in talos_proxmox_gateway_api_crds %}
    - "{{ talos_proxmox_gateway_api_crds_base_url }}/{{ talos_proxmox_gw_crd.type }}/gateway.networking.k8s.io_{{ talos_proxmox_gw_crd.name }}.yaml"
{% endfor %}
{% endif %}
{% endif %}
{% if talos_proxmox_modern_config %}
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: {{ talos_proxmox_talos_installer_image_url }}
provisioning:
  diskSelector:
    match: 'disk.dev_path == {{ talos_proxmox_talos_installation_disk_path | to_json }}'
  wipe: {{ talos_proxmox_talos_installation_disk_wipe | default(false, true) | bool | lower }}
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
{% for talos_proxmox_ns in talos_proxmox_nameservers %}
  - address: {{ talos_proxmox_ns }}
{% endfor %}
{% if talos_proxmox_install_cilium %}
---
apiVersion: v1alpha1
kind: KubeFlannelCNIConfig
$patch: delete
{% endif %}
{% endif %}
