# Contains the talos machine configuration overrides specific for each node
version: v1alpha1
machine:
  network:
    hostname: {{ talos_proxmox_node.name }}
    interfaces:
      - deviceSelector:
          physical: true
        dhcp: false
{% if talos_proxmox_enable_vlans %}
        vlans:
          - vlanId: {{ talos_proxmox_mgmt_vlan_id }}
            addresses:
              - {{ talos_proxmox_node.ip }}/24
{% if talos_proxmox_node in talos_proxmox_masters %}
            vip:
              ip: {{ talos_proxmox_cluster_shared_ip }}
{% endif %}
{% else %}
        addresses:
          - {{ talos_proxmox_node.ip }}/24
        {% if talos_proxmox_node is in talos_proxmox_masters -%}
        vip:
          ip: {{ talos_proxmox_cluster_shared_ip }}
{% endif %}
{% endif %}

  {% if talos_proxmox_enable_longhorn_support and (talos_proxmox_node.storage_disk | default(0, true) | int) > 0 -%}
  kubelet:
    extraMounts:
      - destination: /var/mnt/storage-data
        type: bind
        source: /var/mnt/storage-data
        options:
          - bind
          - rshared
          - rw
{% endif %}

{% if (talos_proxmox_node.storage_disk | default(0, true) | int) > 0 %}
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: storage-data # Name of the volume.
# The provisioning describes how the volume is provisioned.
provisioning:
  # The disk selector expression.
  diskSelector:
    match: disk.transport == "virtio" && !system_disk

  # The minimum size of the volume. Set it to halve of the configured size
  minSize: {{ (talos_proxmox_node.storage_disk | int // 2) }}GiB
# The filesystem describes how the volume is formatted.
filesystem:
    type: xfs # Filesystem type. Default is `xfs`.
{% if (talos_proxmox_node.storage_disk_encryption_key | default("", true) | length) > 0 %}
encryption:
    provider: luks2
    keys:
        - slot: 0
          static:
            passphrase: {{ talos_proxmox_node.storage_disk_encryption_key }}
{% endif -%}
{% endif -%}