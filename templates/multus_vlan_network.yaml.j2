apiVersion: "k8s.cni.cncf.io/v1"
kind: NetworkAttachmentDefinition
metadata:
  name: vlan-{{ talos_proxmox_vlan.type }}-{{ talos_proxmox_vlan.name }}
  namespace: kube-system
spec:
  config: |
    {
      "cniVersion": "0.3.1",
      "type": "vlan",
      "master": "eth0",
      "vlanId": {{ talos_proxmox_vlan.vlan_id }},
      "ipam": {
        "type": "{{ talos_proxmox_vlan.type }}",
        {% if talos_proxmox_vlan.type == "static" -%}
        "addresses": [
          {
            "address": "{{ talos_proxmox_vlan.address }}",
            "gateway": "{{ talos_proxmox_vlan.gateway }}"
          }
        ]
        {% else -%}
        "subnet": "{{ talos_proxmox_vlan.subnet }}",
        "rangeStart": "{{ talos_proxmox_vlan.subnet.split('/')[0] | regex_replace('\d+$', talos_proxmox_vlan.range_start | default(10, true) | string) }}",
        "rangeEnd": "{{ talos_proxmox_vlan.subnet.split('/')[0] | regex_replace('\d+$', talos_proxmox_vlan.range_end | default(250, true) | string) }}",
        "routes": [
          { "dst": "0.0.0.0/0", "gw": "{{ talos_proxmox_vlan.gateway }}" }
        ],
        "gateway": "{{ talos_proxmox_vlan.gateway }}"
        {% endif -%}
      }
    }
